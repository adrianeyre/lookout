# Copy to .env and fill in. Used by `docker compose` and by `pnpm dev`.

# Argon2id hash of your password. Create the whole line with:
#   docker run --rm -it ghcr.io/adrianeyre/lookout:1.0 hash-password --env
# Each $ in the hash is written as $$, as Compose needs.
LOOKOUT_PASSWORD_HASH=
# At least 32 random bytes, for example: openssl rand -base64 32 (a repeated or placeholder
# value is refused)
LOOKOUT_SESSION_SECRET=
# The LAN or Tailscale address to listen on. Never a public address.
LOOKOUT_BIND_ADDRESS=127.0.0.1
# The Docker socket's group, so the non-root Image can reach it: stat -c %g /var/run/docker.sock
DOCKER_GID=

# Optional. Amber and red thresholds for CPU, memory, swap and disk (warn must be lower).
# LOOKOUT_WARN_PERCENT=80
# LOOKOUT_CRITICAL_PERCENT=90
# Optional. Length of the in-memory Live Window behind the sparklines, 1 to 60 minutes.
# LOOKOUT_LIVE_WINDOW_MINUTES=15
# Optional. Port, sample interval (250 to 60000 ms) and session idle expiry (1 to 365 days).
# LOOKOUT_PORT=7777
# LOOKOUT_SAMPLE_INTERVAL_MS=2000
# LOOKOUT_SESSION_IDLE_DAYS=7
# Optional. Sign out this long after signing in, however often used (1 to 365 days, at least
# the idle expiry).
# LOOKOUT_SESSION_MAX_DAYS=30
# Optional. Host names Lookout answers to besides IP addresses and localhost, comma-separated,
# for example a Tailscale MagicDNS name. Any other name is refused (DNS rebinding).
# LOOKOUT_HOSTNAMES=server.tailnet.ts.net
# Optional. true always marks the session cookie Secure (behind an HTTPS proxy that does not
# send X-Forwarded-Proto). Signing in over plain HTTP then fails.
# LOOKOUT_SECURE_COOKIE=false

# Optional. Hosted Sites for the Websites page. Traefik router labels and lookout.url
# Container labels are found automatically; list any other sites here, comma-separated.
# LOOKOUT_SITES=https://example.com/,http://192.168.1.10:8080/
# LOOKOUT_SITE_CHECK_INTERVAL_SECONDS=60
# LOOKOUT_SITE_TIMEOUT_MS=10000
# LOOKOUT_SITE_SLOW_MS=2000
# Optional. Amber and red for TLS certificate expiry, in days (critical must be lower).
# LOOKOUT_TLS_WARN_DAYS=14
# LOOKOUT_TLS_CRITICAL_DAYS=7

# Optional. How often the Host's largest folders are scanned, in hours; 0 scans only when asked.
# LOOKOUT_FOLDER_SCAN_HOURS=6
