{
  "name": "lookout",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "A lightweight, self-hosted dashboard for a Linux Host and its Docker Containers.",
  "license": "MIT",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @lookout/server --filter @lookout/web dev",
    "build": "pnpm --filter @lookout/web build",
    "start": "node apps/server/src/main.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json && tsc -p site/demos",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "hash-password": "node apps/server/src/cli/hash-password.ts",
    "brand:build": "pnpm --filter @lookout/web brand:build",
    "screenshots": "node apps/web/screenshots/capture.ts",
    "measure": "node scripts/measure.ts",
    "site:build": "node site/build.ts build",
    "site:dev": "node site/build.ts dev",
    "site:preview": "node site/build.ts preview",
    "site:check": "node site/check.ts",
    "site:brand": "node site/brand.ts",
    "pen-test:up": "node apps/server/src/pen-test/cli.ts up",
    "pen-test:seed": "node apps/server/src/pen-test/cli.ts seed",
    "pen-test:status": "node apps/server/src/pen-test/cli.ts status",
    "pen-test:probe": "vitest run --config apps/server/vitest.probe.config.ts",
    "pen-test:down": "node apps/server/src/pen-test/cli.ts down"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.65.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@types/node": "26.6.10",
    "@types/react": "19.3.2",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semantic-release": "26.0.1",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
